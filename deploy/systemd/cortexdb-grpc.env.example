# /etc/cortexdb/cortexdb-grpc.env — root:cortexdb, mode 0640.
# This file holds the token, which is the whole access control. Keep it 0640.

# The database file. One cortexdb-grpc process owns it; every other agent
# reaches it through this server, never over a network filesystem.
CORTEXDB_PATH=/var/lib/cortexdb/cortexdb.db

# Listen address. 127.0.0.1 keeps it on the host; use the LAN or Tailscale
# address of this machine to serve other machines. Transport is plaintext by
# design — put it on a trusted network, or in front of a TLS terminator.
CORTEXDB_GRPC_ADDR=127.0.0.1:47821

# Bearer token. Anyone holding it has full read/write access to the brain.
# Generate one with: openssl rand -hex 32
# Leaving it empty disables authentication entirely — only do that on loopback.
CORTEXDB_GRPC_TOKEN=

# Optional: an OpenAI-compatible embeddings endpoint turns on vector search.
# Without it the server runs in lexical mode, which is a supported path, not a
# degraded one. Embedder settings live here, on the server, not on the clients.
#OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#OPENAI_API_KEY=local
#CORTEXDB_EMBED_MODEL=embeddinggemma
#CORTEXDB_EMBED_DIM=768
