# Copy to deploy/docker/.env. Every value has a default; this file only exists
# so you can override them.

# Access control. Generate one: openssl rand -hex 32
CORTEXDB_GRPC_TOKEN=

# Port. Moves the listener, the published port and the healthcheck together.
CORTEXDB_GRPC_PORT=47821

# Which interface the port is published on. 127.0.0.1 keeps the brain on this
# host; use 0.0.0.0 or a LAN / Tailscale address to serve other machines.
CORTEXDB_BIND_HOST=127.0.0.1

# Optional embedder — omit for lexical mode.
#OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#OPENAI_API_KEY=local
#CORTEXDB_EMBED_MODEL=embeddinggemma
#CORTEXDB_EMBED_DIM=768
