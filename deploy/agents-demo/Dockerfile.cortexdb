# cortexdb-grpc sidecar — the memory/knowledge-graph brain the agents connect to.
# Build context is the repo root: docker build -f deploy/agents-demo/Dockerfile.cortexdb .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cortexdb-grpc ./cmd/cortexdb-grpc

FROM alpine:3.20
RUN adduser -D -u 10001 cortex && mkdir -p /data && chown cortex /data
COPY --from=build /out/cortexdb-grpc /usr/local/bin/cortexdb-grpc
VOLUME /data
USER cortex
EXPOSE 47821
ENV CORTEXDB_PATH=/data/agent.db CORTEXDB_GRPC_ADDR=0.0.0.0:47821
ENTRYPOINT ["cortexdb-grpc"]
