#!/bin/sh
# CortexDB SessionStart hook.
#
# Injects a short standing directive so the assistant uses the CortexDB brain
# proactively (recall before answering, save durable facts) every session —
# turning memory use from "if it remembers to" into default behavior.
#
# Opt-in: it only injects when auto-recall is enabled (the same on/off switch
# the UserPromptSubmit hook records), so it never adds noise on machines where
# the user declined CortexDB.
set -eu

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/cortexdb"
sentinel="${cache_root}/autorecall"

# Stay silent unless the user has explicitly enabled auto-recall.
[ -f "$sentinel" ] || exit 0
case "$(cat "$sentinel" 2>/dev/null || true)" in
  on*) : ;;
  *)   exit 0 ;;
esac

# No embedded double quotes in the directive, so no JSON escaping is needed;
# \n stays literal (single-quoted) and the JSON parser turns it into newlines.
directive='<important>You have persistent CortexDB memory through the available CortexDB MCP tools. Use the configured brain (CORTEXDB_REMOTE or CORTEXDB_PATH; default ~/.cortexdb/cortexdb.db) proactively.\n- Before answering from assumptions about past decisions, preferences or project background, call knowledge_memory_recall. Use only relevant returned evidence; unrelated hits do not establish an answer.\n- For relationships such as ownership and dependencies, call graph_schema then graph_cypher_query, expand_graph or SPARQL. A co_occurs edge only means two names appeared together, not ownership, usage or dependency.\n- Save durable preferences, decisions and facts through memory_save or knowledge_save with stable ids and concise content. Preserve corrections and their source.\n- If no relevant evidence is found, say so. If tools are unavailable, skip them.</important>'

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$directive"
exit 0
