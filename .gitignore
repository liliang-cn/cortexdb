# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Local environment secrets
.env
**/.env

# Database files
*.db
*.sqlite
*.sqlite3
**/*.db-shm
**/*.db-wal
# SQLite WAL/SHM sidecars (WAL mode), incl. test DBs whose base name doesn't end in .db
**/*-shm
**/*-wal

# Example-generated artifacts
examples/graphflow_visualization/.env
examples/graphflow_visualization/graphflow_output/
examples/graphflow_visualization/graphflow_visualization
examples/kg_e2e/kg_e2e
/kg_e2e
knowledge_graph_advanced

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.prompt/
.claude/
CLAUDE.md
clients/target/
node_modules/
__pycache__/

# Compiled Go binaries (extensionless on Unix, so the *.exe rules above miss them).
# These were committed by accident and purged from history — do not let them back.
/cortexdb-mcp-stdio
/cortexdb-grpc
/cortexdb-connector-mcp
# Example binaries: `go build` inside examples/<name>/ produces ./<name>.
# Compiled Go binaries have no extension, source/data files do — so ignore only
# extensionless files one level under examples/.
/examples/*/*
!/examples/*/*.*
!/examples/*/*/
# Release staging
/dist/
